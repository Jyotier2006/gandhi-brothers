# Gandhi Brothers — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Razorpay Webhook secret (DIFFERENT from key_secret)
# Create at: Razorpay Dashboard → Settings → Webhooks → Add Webhook
# URL: https://<your-domain>/api/payments/webhook  |  Events: payment.captured
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Tab must be named "Orders" with columns A-P (see src/lib/orders.ts for full schema)
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gandhibrothers.co.in
INTERNAL_API_SECRET=your_super_secret_value_here

# ── Search engine verification (optional) ──────────────────────────────────────
# Google Search Console → Settings → Ownership verification → "HTML tag" → copy the
# content="..." token (NOT the whole tag). Then submit /sitemap.xml inside the console.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → verify via "Meta tag" → copy the content value.
BING_SITE_VERIFICATION=

# ── Resend (transactional email) ───────────────────────────────────────────────
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bulk order inquiry routing
BULK_ORDER_TO_EMAIL=support@gandhibrothers.co.in
BULK_ORDER_FROM_EMAIL=onboarding@resend.dev

# Order confirmation emails
# All three admin addresses receive an email on each successful order
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# Verified sender address — dev: onboarding@resend.dev, prod: orders@gandhibrothers.co.in
# DNS setup (SPF/DKIM/DMARC) required before using custom domain. See src/lib/email.ts.
FROM_EMAIL=onboarding@resend.dev

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_EMAIL=your_shiprocket_login_email
SHIPROCKET_PASSWORD='your_shiprocket_password'
SHIPROCKET_PICKUP_PINCODE=362001
